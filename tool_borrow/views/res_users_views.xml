<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend res.users form to show tool borrow access selection -->
    <record id="res_users_view_form_tool_borrow" model="ir.ui.view">
        <field name="name">res.users.form.tool_borrow</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Tool Borrow" name="tool_borrow" groups="base.group_system">
                    <group>
                        <group string="Tool Borrow Access">
                            <field name="tool_borrow_access"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
