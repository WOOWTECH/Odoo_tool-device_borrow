<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal Home Counter -->
    <template id="portal_my_home_tool_borrow" name="Show Tools and Loans" inherit_id="portal.portal_my_home" customize_show="True" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-if="show_tool_borrow">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/tool_borrow/static/src/img/tools.svg'"/>
                    <t t-set="title">Tools</t>
                    <t t-set="url" t-value="'/my/tools'"/>
                    <t t-set="text">Browse available tools</t>
                    <t t-set="placeholder_count" t-value="'tool_count'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/tool_borrow/static/src/img/loans.svg'"/>
                    <t t-set="title">My Loans</t>
                    <t t-set="url" t-value="'/my/loans'"/>
                    <t t-set="text">View your loan requests</t>
                    <t t-set="placeholder_count" t-value="'loan_count'"/>
                    <t t-set="config_card" t-value="True"/>
                </t>
            </t>
        </xpath>
    </template>

    <!-- Portal Tools List -->
    <template id="portal_my_tools" name="My Tools">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Tools</t>
            </t>

            <t t-if="not tools">
                <div class="alert alert-warning" role="alert">
                    There are no tools available for you.
                </div>
            </t>

            <t t-if="tools">
                <div class="row">
                    <t t-foreach="tools" t-as="tool">
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a t-attf-href="/my/tools/#{tool.id}">
                                            <t t-out="tool.name"/>
                                        </a>
                                    </h5>
                                    <p class="card-text text-muted">
                                        <small>Code: <t t-out="tool.code"/></small>
                                    </p>
                                    <p class="card-text">
                                        <span t-if="tool.state == 'available'" class="badge bg-success">Available</span>
                                        <span t-if="tool.state == 'borrowed'" class="badge bg-warning">Borrowed</span>
                                        <span t-if="tool.state == 'maintenance'" class="badge bg-danger">Maintenance</span>
                                    </p>
                                    <t t-if="tool.category_id">
                                        <p class="card-text">
                                            <small class="text-muted">Category: <t t-out="tool.category_id.name"/></small>
                                        </p>
                                    </t>
                                </div>
                                <div class="card-footer">
                                    <a t-attf-href="/my/tools/#{tool.id}" class="btn btn-primary btn-sm">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Portal Tool Detail -->
    <template id="portal_my_tool_detail" name="Tool Detail">
        <t t-call="portal.portal_layout">
            <div class="card mb-4">
                <div class="card-header">
                    <div class="row">
                        <div class="col-12 col-md-8">
                            <h4 class="mb-0">
                                <t t-out="tool.name"/>
                                <span class="ms-2" t-if="tool.state == 'available'">
                                    <span class="badge bg-success">Available</span>
                                </span>
                                <span class="ms-2" t-if="tool.state == 'borrowed'">
                                    <span class="badge bg-warning">Borrowed</span>
                                </span>
                                <span class="ms-2" t-if="tool.state == 'maintenance'">
                                    <span class="badge bg-danger">Maintenance</span>
                                </span>
                            </h4>
                        </div>
                        <div class="col-12 col-md-4 text-md-end">
                            <small class="text-muted">Code: <t t-out="tool.code"/></small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-12 col-md-6">
                            <strong>Status:</strong>
                            <span t-if="tool.state == 'available'" class="badge bg-success">Available</span>
                            <span t-elif="tool.state == 'borrowed'" class="badge bg-warning">Borrowed</span>
                            <span t-elif="tool.state == 'maintenance'" class="badge bg-danger">Maintenance</span>
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>Category:</strong>
                            <t t-if="tool.category_id"><t t-out="tool.category_id.name"/></t>
                            <t t-else="">-</t>
                        </div>
                    </div>

                    <t t-if="tool.current_borrower_id">
                        <div class="alert alert-info">
                            <strong>Currently borrowed by:</strong> <t t-out="tool.current_borrower_id.name"/>
                        </div>
                    </t>

                    <t t-if="tool.notes">
                        <div class="mb-4">
                            <h5>Notes</h5>
                            <div t-field="tool.notes"/>
                        </div>
                    </t>

                    <!-- Request to Borrow Form -->
                    <t t-if="tool.state == 'available'">
                        <div class="card mt-4">
                            <div class="card-header">
                                <h5 class="mb-0">Request to Borrow</h5>
                            </div>
                            <div class="card-body">
                                <form t-attf-action="/my/tools/#{tool.id}/request" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label for="notes" class="form-label">Notes (optional)</label>
                                        <textarea name="notes" id="notes" class="form-control" rows="3" placeholder="Add any notes for your request..."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        Submit Borrow Request
                                    </button>
                                </form>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <div class="mt-4">
                <a href="/my/tools" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Back to Tools
                </a>
            </div>
        </t>
    </template>

    <!-- Portal Loans List -->
    <template id="portal_my_loans" name="My Loans">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Loans</t>
            </t>

            <t t-if="not loans">
                <div class="alert alert-info" role="alert">
                    You have no loan requests yet.
                    <a href="/my/tools">Browse available tools</a> to make a request.
                </div>
            </t>

            <t t-if="loans">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Tool</th>
                                <th>Request Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="loans" t-as="loan">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/loans/#{loan.id}">
                                            <t t-out="loan.tool_id.name"/>
                                        </a>
                                        <br/>
                                        <small class="text-muted"><t t-out="loan.tool_id.code"/></small>
                                    </td>
                                    <td>
                                        <t t-if="loan.request_date">
                                            <t t-out="loan.request_date"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td>
                                        <span t-if="loan.state == 'draft'" class="badge bg-secondary">Draft</span>
                                        <span t-if="loan.state == 'pending'" class="badge bg-info">Pending</span>
                                        <span t-if="loan.state == 'approved'" class="badge bg-primary">Approved</span>
                                        <span t-if="loan.state == 'rejected'" class="badge bg-danger">Rejected</span>
                                        <span t-if="loan.state == 'borrowed'" class="badge bg-warning">Borrowed</span>
                                        <span t-if="loan.state == 'returned'" class="badge bg-success">Returned</span>
                                    </td>
                                    <td>
                                        <a t-attf-href="/my/loans/#{loan.id}" class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Portal Loan Detail -->
    <template id="portal_my_loan_detail" name="Loan Detail">
        <t t-call="portal.portal_layout">
            <div class="card mb-4">
                <div class="card-header">
                    <div class="row">
                        <div class="col-12 col-md-8">
                            <h4 class="mb-0">
                                Loan Request: <t t-out="loan.tool_id.name"/>
                            </h4>
                        </div>
                        <div class="col-12 col-md-4 text-md-end">
                            <span t-if="loan.state == 'draft'" class="badge bg-secondary">Draft</span>
                            <span t-if="loan.state == 'pending'" class="badge bg-info">Pending</span>
                            <span t-if="loan.state == 'approved'" class="badge bg-primary">Approved</span>
                            <span t-if="loan.state == 'rejected'" class="badge bg-danger">Rejected</span>
                            <span t-if="loan.state == 'borrowed'" class="badge bg-warning">Borrowed</span>
                            <span t-if="loan.state == 'returned'" class="badge bg-success">Returned</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <strong>Tool:</strong>
                            <a t-attf-href="/my/tools/#{loan.tool_id.id}">
                                <t t-out="loan.tool_id.name"/>
                            </a>
                            (<t t-out="loan.tool_id.code"/>)
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>Borrower:</strong>
                            <t t-out="loan.user_id.name"/>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <strong>Request Date:</strong>
                            <t t-if="loan.request_date"><t t-out="loan.request_date"/></t>
                            <t t-else="">-</t>
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>Approved Date:</strong>
                            <t t-if="loan.approved_date"><t t-out="loan.approved_date"/></t>
                            <t t-else="">-</t>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <strong>Borrow Date:</strong>
                            <t t-if="loan.borrow_date"><t t-out="loan.borrow_date"/></t>
                            <t t-else="">-</t>
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>Return Date:</strong>
                            <t t-if="loan.return_date"><t t-out="loan.return_date"/></t>
                            <t t-else="">-</t>
                        </div>
                    </div>

                    <t t-if="loan.approved_by">
                        <div class="row mb-3">
                            <div class="col-12">
                                <strong>Approved By:</strong>
                                <t t-out="loan.approved_by.name"/>
                            </div>
                        </div>
                    </t>

                    <t t-if="loan.notes">
                        <div class="mb-3">
                            <strong>Notes:</strong>
                            <p><t t-out="loan.notes"/></p>
                        </div>
                    </t>

                    <!-- Status Timeline -->
                    <div class="mt-4">
                        <h5>Status Timeline</h5>
                        <ul class="list-group">
                            <li class="list-group-item" t-att-class="'list-group-item-success' if loan.state in ['draft', 'pending', 'approved', 'borrowed', 'returned'] else ''">
                                <i class="fa fa-check-circle text-success" t-if="loan.state in ['pending', 'approved', 'borrowed', 'returned']"/>
                                <i class="fa fa-circle-o text-muted" t-else=""/>
                                Draft / Submitted
                            </li>
                            <li class="list-group-item" t-att-class="'list-group-item-success' if loan.state in ['approved', 'borrowed', 'returned'] else ('list-group-item-danger' if loan.state == 'rejected' else '')">
                                <i class="fa fa-check-circle text-success" t-if="loan.state in ['approved', 'borrowed', 'returned']"/>
                                <i class="fa fa-times-circle text-danger" t-if="loan.state == 'rejected'"/>
                                <i class="fa fa-circle-o text-muted" t-if="loan.state in ['draft', 'pending']"/>
                                <t t-if="loan.state == 'rejected'">Rejected</t>
                                <t t-else="">Approved</t>
                            </li>
                            <li class="list-group-item" t-att-class="'list-group-item-success' if loan.state in ['borrowed', 'returned'] else ''">
                                <i class="fa fa-check-circle text-success" t-if="loan.state in ['borrowed', 'returned']"/>
                                <i class="fa fa-circle-o text-muted" t-else=""/>
                                Borrowed
                            </li>
                            <li class="list-group-item" t-att-class="'list-group-item-success' if loan.state == 'returned' else ''">
                                <i class="fa fa-check-circle text-success" t-if="loan.state == 'returned'"/>
                                <i class="fa fa-circle-o text-muted" t-else=""/>
                                Returned
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a href="/my/loans" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Back to My Loans
                </a>
            </div>
        </t>
    </template>
</odoo>
