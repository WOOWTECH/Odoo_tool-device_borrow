<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Portal Home — Equipment Borrowing entry card
         ============================================================ -->
    <template id="portal_my_home_tool_borrow" name="Equipment Borrowing"
              inherit_id="portal.portal_my_home" customize_show="True" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='portal_service_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/tool_borrow/static/src/img/equipment.svg'"/>
                <t t-set="title">Equipment Borrowing</t>
                <t t-set="url" t-value="'/my/equipment'"/>
                <t t-set="text">Browse equipment and manage borrowing</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- ============================================================
         Equipment Hub — sub-portal with Equipment Tools + My Loans
         ============================================================ -->
    <template id="portal_my_equipment" name="Equipment Hub">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>

            <div class="o_portal_my_home">
                <div class="o_portal_category row g-2 mt-3">
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/tool_borrow/static/src/img/tools.svg'"/>
                        <t t-set="title">Equipment Tools</t>
                        <t t-set="url" t-value="'/my/tools'"/>
                        <t t-set="text">Browse available tool equipment</t>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/tool_borrow/static/src/img/loans.svg'"/>
                        <t t-set="title">My Loans</t>
                        <t t-set="url" t-value="'/my/loans'"/>
                        <t t-set="text">View and manage loan records</t>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================
         Breadcrumbs for Equipment / Tools / Loans pages
         ============================================================ -->
    <template id="portal_breadcrumbs_tool_borrow" name="Tool Borrow Breadcrumbs"
              inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol" position="inside">
            <li t-if="page_name == 'equipment'" class="breadcrumb-item active">Equipment Borrowing</li>
            <li t-if="page_name == 'tools'" class="breadcrumb-item"><a href="/my/equipment">Equipment Borrowing</a></li>
            <li t-if="page_name == 'tools'" class="breadcrumb-item active">Equipment Tools</li>
            <li t-if="page_name == 'tool_detail'" class="breadcrumb-item"><a href="/my/equipment">Equipment Borrowing</a></li>
            <li t-if="page_name == 'tool_detail'" class="breadcrumb-item"><a href="/my/tools">Equipment Tools</a></li>
            <li t-if="page_name == 'tool_detail'" class="breadcrumb-item active" t-esc="tool.name"/>
            <li t-if="page_name == 'loans'" class="breadcrumb-item"><a href="/my/equipment">Equipment Borrowing</a></li>
            <li t-if="page_name == 'loans'" class="breadcrumb-item active">My Loans</li>
            <li t-if="page_name == 'loan_detail'" class="breadcrumb-item"><a href="/my/equipment">Equipment Borrowing</a></li>
            <li t-if="page_name == 'loan_detail'" class="breadcrumb-item"><a href="/my/loans">My Loans</a></li>
            <li t-if="page_name == 'loan_detail'" class="breadcrumb-item active">Loan Request</li>
        </xpath>
    </template>

    <!-- ============================================================
         Portal Tools List — Native Odoo Table
         ============================================================ -->
    <template id="portal_my_tools" name="My Tools">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Equipment Tools</t>
            </t>

            <t t-if="not tools">
                <div class="alert alert-warning" role="alert">
                    There are no tools available for you.
                </div>
            </t>

            <t t-if="tools">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Name</th>
                            <th>Code</th>
                            <th class="d-none d-md-table-cell">Category</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>
                    <t t-foreach="tools" t-as="tool">
                        <tr>
                            <td>
                                <a t-attf-href="/my/tools/#{tool.id}">
                                    <t t-esc="tool.name"/>
                                </a>
                            </td>
                            <td><t t-esc="tool.code"/></td>
                            <td class="d-none d-md-table-cell">
                                <t t-if="tool.category_id"><t t-esc="tool.category_id.name"/></t>
                            </td>
                            <td class="text-end">
                                <span t-if="tool.state == 'available'"
                                      class="badge rounded-pill text-bg-success">Available</span>
                                <span t-if="tool.state in ['borrowed', 'unavailable']"
                                      class="badge rounded-pill text-bg-warning">Borrowed</span>
                                <span t-if="tool.state == 'maintenance'"
                                      class="badge rounded-pill text-bg-danger">Under Maintenance</span>
                            </td>
                        </tr>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================================
         Portal Tool Detail — Sidebar + Chatter + Record Pager
         ============================================================ -->
    <template id="portal_my_tool_detail" name="Tool Detail"
              inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">

            <div class="row">
                <!-- Sidebar -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>

                    <t t-set="entries">
                        <div class="d-flex flex-wrap flex-column gap-4">
                            <!-- Navigation -->
                            <div class="d-flex align-items-center flex-grow-1 p-0" t-ignore="true" role="complementary">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#card_header">Tool Details</a>
                                    </li>
                                    <li t-if="tool.state == 'available'" class="nav-item">
                                        <a class="nav-link p-0" href="#request_form">Request to Borrow</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#tool_chat">History</a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Tool Info -->
                            <div class="d-flex flex-column gap-2">
                                <div>
                                    <small class="text-muted">Status</small><br/>
                                    <span t-if="tool.state == 'available'"
                                          class="badge rounded-pill text-bg-success">Available</span>
                                    <span t-if="tool.state in ['borrowed', 'unavailable']"
                                          class="badge rounded-pill text-bg-warning">Borrowed</span>
                                    <span t-if="tool.state == 'maintenance'"
                                          class="badge rounded-pill text-bg-danger">Under Maintenance</span>
                                </div>
                                <div t-if="tool.category_id">
                                    <small class="text-muted">Category</small><br/>
                                    <span t-esc="tool.category_id.name"/>
                                </div>
                                <div t-if="tool.code">
                                    <small class="text-muted">Code</small><br/>
                                    <span t-esc="tool.code"/>
                                </div>
                                <div t-if="tool.current_borrower_id">
                                    <small class="text-muted">Current Borrower</small><br/>
                                    <span t-esc="tool.current_borrower_id.name"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- Main Content -->
                <div id="tool_content" class="o_portal_content col-12 col-lg-8 col-xxl-9">
                    <div id="card">
                        <div id="card_header" data-anchor="true">
                            <div class="row justify-content-between mb-3">
                                <div class="col-12 col-md-9">
                                    <h3 class="my-0">
                                        <span t-field="tool.name"/>
                                        <small class="text-muted d-none d-md-inline">(<t t-esc="tool.code"/>)</small>
                                    </h3>
                                </div>
                                <div class="col-auto">
                                    <span t-if="tool.state == 'available'"
                                          class="badge rounded-pill text-bg-success">Available</span>
                                    <span t-if="tool.state in ['borrowed', 'unavailable']"
                                          class="badge rounded-pill text-bg-warning">Borrowed</span>
                                    <span t-if="tool.state == 'maintenance'"
                                          class="badge rounded-pill text-bg-danger">Under Maintenance</span>
                                </div>
                            </div>
                        </div>

                        <div id="card_body">
                            <!-- Tool Information -->
                            <div class="row mb-4">
                                <div class="col-12 col-md-6">
                                    <div t-if="tool.category_id">
                                        <strong>Category:</strong>
                                        <span t-esc="tool.category_id.name"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Current Borrower Alert -->
                            <div t-if="tool.current_borrower_id" class="alert alert-warning" role="alert">
                                <strong>Currently borrowed by:</strong> <t t-esc="tool.current_borrower_id.name"/>
                            </div>

                            <!-- Notes -->
                            <div t-if="not is_html_empty(tool.notes)" class="mb-4">
                                <h5 class="mb-1">Notes</h5>
                                <hr class="mt-1 mb-2"/>
                                <div class="py-1 px-2 bg-100 small" t-field="tool.notes"/>
                            </div>

                            <!-- Request to Borrow Form -->
                            <div t-if="tool.state == 'available'" id="request_form" data-anchor="true" class="mb-4">
                                <h5 class="mb-1">Request to Borrow</h5>
                                <hr class="mt-1 mb-2"/>
                                <form t-attf-action="/my/tools/#{tool.id}/request" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label for="notes" class="form-label">Notes (optional)</label>
                                        <textarea name="notes" id="notes" class="form-control" rows="3"
                                                  placeholder="Add any notes for your request..."/>
                                    </div>
                                    <button type="submit" class="btn btn-light">
                                        Submit Borrow Request
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <hr/>
                    <!-- Chatter -->
                    <div id="tool_chat" data-anchor="true">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="tool"/>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Record Pager (prev/next) -->
            <t t-call="portal.record_pager"/>
        </xpath>
    </template>

    <!-- ============================================================
         Portal Loans List — Native Odoo Table
         ============================================================ -->
    <template id="portal_my_loans" name="My Loans">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">My Loans</t>
            </t>

            <t t-if="not loans">
                <div class="alert alert-warning" role="alert">
                    You have no loan requests yet.
                    <a href="/my/tools">Browse available tools</a>
                </div>
            </t>

            <t t-if="loans">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Tool</th>
                            <th class="d-none d-md-table-cell">Request Date</th>
                            <th class="text-center">Status</th>
                            <th class="text-end"/>
                        </tr>
                    </thead>
                    <t t-foreach="loans" t-as="loan">
                        <tr>
                            <td>
                                <a t-attf-href="/my/loans/#{loan.id}">
                                    <t t-esc="loan.tool_id.name"/>
                                </a>
                                <div class="small text-muted"><t t-esc="loan.tool_id.code"/></div>
                            </td>
                            <td class="d-none d-md-table-cell">
                                <t t-if="loan.request_date">
                                    <span t-field="loan.request_date" t-options="{'widget': 'date'}"/>
                                </t>
                                <t t-else="">—</t>
                            </td>
                            <td class="text-center">
                                <span t-if="loan.state == 'draft'" class="badge rounded-pill text-bg-secondary">Draft</span>
                                <span t-if="loan.state == 'pending'" class="badge rounded-pill text-bg-info">Pending Approval</span>
                                <span t-if="loan.state == 'approved'" class="badge rounded-pill text-bg-primary">Approved</span>
                                <span t-if="loan.state == 'rejected'" class="badge rounded-pill text-bg-danger">Rejected</span>
                                <span t-if="loan.state == 'borrowed'" class="badge rounded-pill text-bg-warning">Borrowed</span>
                                <span t-if="loan.state == 'returned'" class="badge rounded-pill text-bg-success">Returned</span>
                            </td>
                            <td class="text-end">
                                <a t-attf-href="/my/loans/#{loan.id}">View</a>
                            </td>
                        </tr>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================================================
         Portal Loan Detail — Sidebar + Chatter + Record Pager
         ============================================================ -->
    <template id="portal_my_loan_detail" name="Loan Detail"
              inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">

            <div class="row">
                <!-- Sidebar -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none'"/>

                    <t t-set="entries">
                        <div class="d-flex flex-wrap flex-column gap-4">
                            <!-- Navigation -->
                            <div class="d-flex align-items-center flex-grow-1 p-0" t-ignore="true" role="complementary">
                                <ul class="nav flex-column">
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#card_header">Loan Details</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#loan_timeline">Status Timeline</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link p-0" href="#loan_chat">History</a>
                                    </li>
                                </ul>
                            </div>

                            <!-- Loan Status -->
                            <div class="d-flex flex-column gap-2">
                                <div>
                                    <small class="text-muted">Status</small><br/>
                                    <span t-if="loan.state == 'draft'" class="badge rounded-pill text-bg-secondary">Draft</span>
                                    <span t-if="loan.state == 'pending'" class="badge rounded-pill text-bg-info">Pending Approval</span>
                                    <span t-if="loan.state == 'approved'" class="badge rounded-pill text-bg-primary">Approved</span>
                                    <span t-if="loan.state == 'rejected'" class="badge rounded-pill text-bg-danger">Rejected</span>
                                    <span t-if="loan.state == 'borrowed'" class="badge rounded-pill text-bg-warning">Borrowed</span>
                                    <span t-if="loan.state == 'returned'" class="badge rounded-pill text-bg-success">Returned</span>
                                </div>
                                <div>
                                    <small class="text-muted">Tool</small><br/>
                                    <a t-attf-href="/my/tools/#{loan.tool_id.id}">
                                        <t t-esc="loan.tool_id.name"/>
                                    </a>
                                </div>
                                <div>
                                    <small class="text-muted">Borrower</small><br/>
                                    <span t-esc="loan.user_id.name"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- Main Content -->
                <div id="loan_content" class="o_portal_content col-12 col-lg-8 col-xxl-9">
                    <div id="card">
                        <div id="card_header" data-anchor="true">
                            <div class="row justify-content-between mb-3">
                                <div class="col-12 col-md-9">
                                    <h3 class="my-0">
                                        Loan Request
                                        <small class="text-muted"> — <t t-esc="loan.tool_id.name"/></small>
                                    </h3>
                                </div>
                                <div class="col-auto">
                                    <span t-if="loan.state == 'draft'" class="badge rounded-pill text-bg-secondary">Draft</span>
                                    <span t-if="loan.state == 'pending'" class="badge rounded-pill text-bg-info">Pending Approval</span>
                                    <span t-if="loan.state == 'approved'" class="badge rounded-pill text-bg-primary">Approved</span>
                                    <span t-if="loan.state == 'rejected'" class="badge rounded-pill text-bg-danger">Rejected</span>
                                    <span t-if="loan.state == 'borrowed'" class="badge rounded-pill text-bg-warning">Borrowed</span>
                                    <span t-if="loan.state == 'returned'" class="badge rounded-pill text-bg-success">Returned</span>
                                </div>
                            </div>
                        </div>

                        <div id="card_body">
                            <!-- Loan Details -->
                            <div class="row mb-4">
                                <div class="col-12 col-md-6">
                                    <div><strong>Tool:</strong>
                                        <a t-attf-href="/my/tools/#{loan.tool_id.id}">
                                            <t t-esc="loan.tool_id.name"/>
                                        </a>
                                        <span class="text-muted small">(<t t-esc="loan.tool_id.code"/>)</span>
                                    </div>
                                    <div><strong>Borrower:</strong> <span t-esc="loan.user_id.name"/></div>
                                    <div t-if="loan.approved_by"><strong>Approved By:</strong> <span t-esc="loan.approved_by.name"/></div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div><strong>Request Date:</strong>
                                        <t t-if="loan.request_date"><span t-field="loan.request_date" t-options="{'widget': 'date'}"/></t>
                                        <t t-else="">—</t>
                                    </div>
                                    <div><strong>Approved Date:</strong>
                                        <t t-if="loan.approved_date"><span t-field="loan.approved_date" t-options="{'widget': 'date'}"/></t>
                                        <t t-else="">—</t>
                                    </div>
                                    <div><strong>Borrow Date:</strong>
                                        <t t-if="loan.borrow_date"><span t-field="loan.borrow_date" t-options="{'widget': 'date'}"/></t>
                                        <t t-else="">—</t>
                                    </div>
                                    <div><strong>Return Date:</strong>
                                        <t t-if="loan.return_date"><span t-field="loan.return_date" t-options="{'widget': 'date'}"/></t>
                                        <t t-else="">—</t>
                                    </div>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div t-if="loan.notes" class="mb-4">
                                <h5 class="mb-1">Notes</h5>
                                <hr class="mt-1 mb-2"/>
                                <div class="py-1 px-2 bg-100 small"><t t-esc="loan.notes"/></div>
                            </div>

                            <!-- Status Timeline -->
                            <div id="loan_timeline" data-anchor="true" class="mb-4">
                                <h5 class="mb-1">Status Timeline</h5>
                                <hr class="mt-1 mb-2"/>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex align-items-center gap-2">
                                        <i t-attf-class="fa fa-check-circle #{'text-success' if loan.state in ['pending', 'approved', 'borrowed', 'returned'] else 'text-muted'}"/>
                                        <div>
                                            <strong>Draft / Submitted</strong>
                                            <div t-if="loan.request_date" class="small text-muted">
                                                <span t-field="loan.request_date" t-options="{'widget': 'datetime'}"/>
                                            </div>
                                        </div>
                                    </li>
                                    <li class="list-group-item d-flex align-items-center gap-2">
                                        <i t-if="loan.state == 'rejected'" class="fa fa-times-circle text-danger"/>
                                        <i t-elif="loan.state in ['approved', 'borrowed', 'returned']" class="fa fa-check-circle text-success"/>
                                        <i t-elif="loan.state == 'pending'" class="fa fa-clock-o text-info"/>
                                        <i t-else="" class="fa fa-circle-o text-muted"/>
                                        <div>
                                            <strong t-if="loan.state == 'rejected'">Rejected</strong>
                                            <strong t-elif="loan.state == 'pending'">Under Review...</strong>
                                            <strong t-else="">Approved</strong>
                                            <div t-if="loan.approved_date" class="small text-muted">
                                                <span t-field="loan.approved_date" t-options="{'widget': 'datetime'}"/>
                                            </div>
                                        </div>
                                    </li>
                                    <li t-if="loan.state != 'rejected'" class="list-group-item d-flex align-items-center gap-2">
                                        <i t-attf-class="fa #{'fa-check-circle text-success' if loan.state in ['borrowed', 'returned'] else 'fa-circle-o text-muted'}"/>
                                        <div>
                                            <strong t-attf-class="#{'text-muted' if loan.state not in ['borrowed', 'returned'] else ''}">Borrowed</strong>
                                            <div t-if="loan.borrow_date" class="small text-muted">
                                                <span t-field="loan.borrow_date" t-options="{'widget': 'datetime'}"/>
                                            </div>
                                        </div>
                                    </li>
                                    <li t-if="loan.state != 'rejected'" class="list-group-item d-flex align-items-center gap-2">
                                        <i t-attf-class="fa #{'fa-check-circle text-success' if loan.state == 'returned' else 'fa-circle-o text-muted'}"/>
                                        <div>
                                            <strong t-attf-class="#{'text-muted' if loan.state != 'returned' else ''}">Returned</strong>
                                            <div t-if="loan.return_date" class="small text-muted">
                                                <span t-field="loan.return_date" t-options="{'widget': 'datetime'}"/>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <hr/>
                    <!-- Chatter -->
                    <div id="loan_chat" data-anchor="true">
                        <h3>Communication history</h3>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="loan"/>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Record Pager (prev/next) -->
            <t t-call="portal.record_pager"/>
        </xpath>
    </template>

</odoo>
