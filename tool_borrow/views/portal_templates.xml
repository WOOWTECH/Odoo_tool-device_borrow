<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Material Design Icons CDN -->
    <template id="portal_mdi_assets" inherit_id="web.frontend_layout" name="Tool Borrow MDI Assets">
        <xpath expr="//head" position="inside">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css"/>
            <style>
                .o_portal_icon .mdi {
                    font-size: 2.5rem;
                    color: #714B67;
                }
            </style>
        </xpath>
    </template>

    <!-- Custom portal entry with MDI icon support -->
    <template id="portal_docs_entry_mdi" name="Portal Docs Entry with MDI Icon">
        <t t-set="force_show" t-value="placeholder_count and request.session.get('portal_counters', {}).get(placeholder_count) and not show_count"/>
        <div t-att-class="'o_portal_index_card ' +  ('' if force_show or config_card else 'd-none ') + ('col-12 order-0' if show_count else 'col-md-6 order-2')">
            <a t-att-href="url" t-att-title="title" t-attf-class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none #{bg_color if bg_color else 'bg-100'}">
                <div t-if="icon_class" class="o_portal_icon d-block align-self-start">
                    <i t-att-class="icon_class"/>
                </div>
                <div t-att-class="'alert-link' if bg_color else ''">
                    <div t-attf-class="mt-0 mb-1 fs-5 fw-normal lh-1 #{'d-flex gap-2' if placeholder_count or count else ''}">
                        <t t-out="count"/>
                        <span t-if="placeholder_count and not force_show" t-att-class="'fw-bold' if show_count else 'd-none'" t-att-data-placeholder_count="placeholder_count"/>
                        <span t-out="title"/>
                    </div>
                    <div class="opacity-75">
                        <t t-out="text"/>
                    </div>
                </div>
            </a>
        </div>
    </template>

    <!-- Portal Home Counter -->
    <template id="portal_my_home_tool_borrow" name="Show Tools and Loans" inherit_id="portal.portal_my_home" customize_show="True" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-call="tool_borrow.portal_docs_entry_mdi">
                <t t-set="icon_class">mdi mdi-tools</t>
                <t t-set="title">工具</t>
                <t t-set="url" t-value="'/my/tools'"/>
                <t t-set="text">瀏覽可用工具</t>
                <t t-set="placeholder_count" t-value="'tool_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
            <t t-call="tool_borrow.portal_docs_entry_mdi">
                <t t-set="icon_class">mdi mdi-clipboard-text-clock-outline</t>
                <t t-set="title">我的借用</t>
                <t t-set="url" t-value="'/my/loans'"/>
                <t t-set="text">查看您的借用請求</t>
                <t t-set="placeholder_count" t-value="'loan_count'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
        <!-- Replace Security card with MDI icon version -->
        <xpath expr="//div[@id='portal_common_category']/t[@t-call='portal.portal_docs_entry'][not(@t-if)]" position="replace">
            <t t-call="tool_borrow.portal_docs_entry_mdi">
                <t t-set="icon_class">mdi mdi-shield-lock-outline</t>
                <t t-set="title">連線及保安</t>
                <t t-set="url" t-value="'/my/security'"/>
                <t t-set="text">配置您的連線參數</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- Portal Tools List -->
    <template id="portal_my_tools" name="My Tools">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">工具</t>
            </t>

            <t t-if="not tools">
                <div class="alert alert-warning" role="alert">
                    目前沒有可供您使用的工具。
                </div>
            </t>

            <t t-if="tools">
                <div class="row">
                    <t t-foreach="tools" t-as="tool">
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a t-attf-href="/my/tools/#{tool.id}">
                                            <t t-out="tool.name"/>
                                        </a>
                                    </h5>
                                    <p class="card-text text-muted">
                                        <small>編號: <t t-out="tool.code"/></small>
                                    </p>
                                    <p class="card-text">
                                        <span t-if="tool.state == 'available'" class="badge bg-success">可借用</span>
                                        <span t-if="tool.state == 'borrowed'" class="badge bg-warning">已借出</span>
                                        <span t-if="tool.state == 'maintenance'" class="badge bg-danger">維護中</span>
                                    </p>
                                    <t t-if="tool.category_id">
                                        <p class="card-text">
                                            <small class="text-muted">類別: <t t-out="tool.category_id.name"/></small>
                                        </p>
                                    </t>
                                </div>
                                <div class="card-footer">
                                    <a t-attf-href="/my/tools/#{tool.id}" class="btn btn-primary btn-sm">
                                        查看詳情
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Portal Tool Detail -->
    <template id="portal_my_tool_detail" name="Tool Detail">
        <t t-call="portal.portal_layout">
            <div class="card mb-4">
                <div class="card-header">
                    <div class="row">
                        <div class="col-12 col-md-8">
                            <h4 class="mb-0">
                                <t t-out="tool.name"/>
                                <span class="ms-2" t-if="tool.state == 'available'">
                                    <span class="badge bg-success">可借用</span>
                                </span>
                                <span class="ms-2" t-if="tool.state == 'borrowed'">
                                    <span class="badge bg-warning">已借出</span>
                                </span>
                                <span class="ms-2" t-if="tool.state == 'maintenance'">
                                    <span class="badge bg-danger">維護中</span>
                                </span>
                            </h4>
                        </div>
                        <div class="col-12 col-md-4 text-md-end">
                            <small class="text-muted">編號: <t t-out="tool.code"/></small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-12 col-md-6">
                            <strong>階段:</strong>
                            <t t-if="tool.stage_id"><t t-out="tool.stage_id.name"/></t>
                            <t t-else="">-</t>
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>類別:</strong>
                            <t t-if="tool.category_id"><t t-out="tool.category_id.name"/></t>
                            <t t-else="">-</t>
                        </div>
                    </div>

                    <t t-if="tool.current_borrower_id">
                        <div class="alert alert-info">
                            <strong>目前借用者:</strong> <t t-out="tool.current_borrower_id.name"/>
                        </div>
                    </t>

                    <t t-if="tool.notes">
                        <div class="mb-4">
                            <h5>備註</h5>
                            <div t-field="tool.notes"/>
                        </div>
                    </t>

                    <!-- Request to Borrow Form -->
                    <t t-if="tool.state == 'available'">
                        <div class="card mt-4">
                            <div class="card-header">
                                <h5 class="mb-0">申請借用</h5>
                            </div>
                            <div class="card-body">
                                <form t-attf-action="/my/tools/#{tool.id}/request" method="POST">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="mb-3">
                                        <label for="notes" class="form-label">備註（選填）</label>
                                        <textarea name="notes" id="notes" class="form-control" rows="3" placeholder="新增您的請求備註..."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        提交借用請求
                                    </button>
                                </form>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <div class="mt-4">
                <a href="/my/tools" class="btn btn-secondary">
                    <i class="mdi mdi-arrow-left"></i> 返回工具列表
                </a>
            </div>
        </t>
    </template>

    <!-- Portal Loans List -->
    <template id="portal_my_loans" name="My Loans">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">我的借用</t>
            </t>

            <t t-if="not loans">
                <div class="alert alert-info" role="alert">
                    您目前沒有借用請求。
                    <a href="/my/tools">瀏覽可用工具</a>以提出請求。
                </div>
            </t>

            <t t-if="loans">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>工具</th>
                                <th>申請日期</th>
                                <th>狀態</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="loans" t-as="loan">
                                <tr>
                                    <td>
                                        <a t-attf-href="/my/loans/#{loan.id}">
                                            <t t-out="loan.tool_id.name"/>
                                        </a>
                                        <br/>
                                        <small class="text-muted"><t t-out="loan.tool_id.code"/></small>
                                    </td>
                                    <td>
                                        <t t-if="loan.request_date">
                                            <t t-out="loan.request_date"/>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                    <td>
                                        <span t-if="loan.state == 'draft'" class="badge bg-secondary">草稿</span>
                                        <span t-if="loan.state == 'pending'" class="badge bg-info">待審核</span>
                                        <span t-if="loan.state == 'approved'" class="badge bg-primary">已批准</span>
                                        <span t-if="loan.state == 'rejected'" class="badge bg-danger">已拒絕</span>
                                        <span t-if="loan.state == 'borrowed'" class="badge bg-warning">已借出</span>
                                        <span t-if="loan.state == 'returned'" class="badge bg-success">已歸還</span>
                                    </td>
                                    <td>
                                        <a t-attf-href="/my/loans/#{loan.id}" class="btn btn-sm btn-outline-primary">
                                            查看
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Portal Loan Detail -->
    <template id="portal_my_loan_detail" name="Loan Detail">
        <t t-call="portal.portal_layout">
            <div class="card mb-4">
                <div class="card-header">
                    <div class="row">
                        <div class="col-12 col-md-8">
                            <h4 class="mb-0">
                                借用請求: <t t-out="loan.tool_id.name"/>
                            </h4>
                        </div>
                        <div class="col-12 col-md-4 text-md-end">
                            <span t-if="loan.state == 'draft'" class="badge bg-secondary">草稿</span>
                            <span t-if="loan.state == 'pending'" class="badge bg-info">待審核</span>
                            <span t-if="loan.state == 'approved'" class="badge bg-primary">已批准</span>
                            <span t-if="loan.state == 'rejected'" class="badge bg-danger">已拒絕</span>
                            <span t-if="loan.state == 'borrowed'" class="badge bg-warning">已借出</span>
                            <span t-if="loan.state == 'returned'" class="badge bg-success">已歸還</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <strong>工具:</strong>
                            <a t-attf-href="/my/tools/#{loan.tool_id.id}">
                                <t t-out="loan.tool_id.name"/>
                            </a>
                            (<t t-out="loan.tool_id.code"/>)
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>借用人:</strong>
                            <t t-out="loan.user_id.name"/>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <strong>申請日期:</strong>
                            <t t-if="loan.request_date"><t t-out="loan.request_date"/></t>
                            <t t-else="">-</t>
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>批准日期:</strong>
                            <t t-if="loan.approved_date"><t t-out="loan.approved_date"/></t>
                            <t t-else="">-</t>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 col-md-6">
                            <strong>借出日期:</strong>
                            <t t-if="loan.borrow_date"><t t-out="loan.borrow_date"/></t>
                            <t t-else="">-</t>
                        </div>
                        <div class="col-12 col-md-6">
                            <strong>歸還日期:</strong>
                            <t t-if="loan.return_date"><t t-out="loan.return_date"/></t>
                            <t t-else="">-</t>
                        </div>
                    </div>

                    <t t-if="loan.approved_by">
                        <div class="row mb-3">
                            <div class="col-12">
                                <strong>批准人:</strong>
                                <t t-out="loan.approved_by.name"/>
                            </div>
                        </div>
                    </t>

                    <t t-if="loan.notes">
                        <div class="mb-3">
                            <strong>備註:</strong>
                            <p><t t-out="loan.notes"/></p>
                        </div>
                    </t>

                    <!-- Status Timeline -->
                    <div class="mt-4">
                        <h5>狀態時間軸</h5>
                        <ul class="list-group">
                            <li class="list-group-item" t-att-class="'list-group-item-success' if loan.state in ['draft', 'pending', 'approved', 'borrowed', 'returned'] else ''">
                                <i class="mdi mdi-check-circle text-success" t-if="loan.state in ['pending', 'approved', 'borrowed', 'returned']"/>
                                <i class="mdi mdi-circle-outline text-muted" t-else=""/>
                                草稿 / 已提交
                            </li>
                            <li class="list-group-item" t-att-class="'list-group-item-success' if loan.state in ['approved', 'borrowed', 'returned'] else ('list-group-item-danger' if loan.state == 'rejected' else '')">
                                <i class="mdi mdi-check-circle text-success" t-if="loan.state in ['approved', 'borrowed', 'returned']"/>
                                <i class="mdi mdi-close-circle text-danger" t-if="loan.state == 'rejected'"/>
                                <i class="mdi mdi-circle-outline text-muted" t-if="loan.state in ['draft', 'pending']"/>
                                <t t-if="loan.state == 'rejected'">已拒絕</t>
                                <t t-else="">已批准</t>
                            </li>
                            <li class="list-group-item" t-att-class="'list-group-item-success' if loan.state in ['borrowed', 'returned'] else ''">
                                <i class="mdi mdi-check-circle text-success" t-if="loan.state in ['borrowed', 'returned']"/>
                                <i class="mdi mdi-circle-outline text-muted" t-else=""/>
                                已借出
                            </li>
                            <li class="list-group-item" t-att-class="'list-group-item-success' if loan.state == 'returned' else ''">
                                <i class="mdi mdi-check-circle text-success" t-if="loan.state == 'returned'"/>
                                <i class="mdi mdi-circle-outline text-muted" t-else=""/>
                                已歸還
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a href="/my/loans" class="btn btn-secondary">
                    <i class="mdi mdi-arrow-left"></i> 返回我的借用
                </a>
            </div>
        </t>
    </template>
</odoo>
