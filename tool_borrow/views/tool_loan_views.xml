<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Loan List View (Odoo 18 syntax) -->
    <record id="tool_loan_view_list" model="ir.ui.view">
        <field name="name">tool.loan.list</field>
        <field name="model">tool.loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="tool_id"/>
                <field name="user_id"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('pending', 'approved')" decoration-success="state == 'returned'" decoration-primary="state == 'borrowed'" decoration-danger="state == 'rejected'"/>
                <field name="request_date" readonly="1"/>
                <field name="borrow_date" readonly="1"/>
                <field name="return_date" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Loan Form View -->
    <record id="tool_loan_view_form" model="ir.ui.view">
        <field name="name">tool.loan.form</field>
        <field name="model">tool.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit Request" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'" groups="tool_borrow.group_tool_manager"/>
                    <button name="action_reject" type="object" string="Reject" class="btn-danger" invisible="state != 'pending'" groups="tool_borrow.group_tool_manager"/>
                    <button name="action_confirm_borrow" type="object" string="Confirm Borrow" class="btn-primary" invisible="state != 'approved'" groups="tool_borrow.group_tool_manager"/>
                    <button name="action_confirm_return" type="object" string="Confirm Return" class="btn-primary" invisible="state != 'borrowed'" groups="tool_borrow.group_tool_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" class="btn-secondary" invisible="state not in ('rejected', 'pending')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,borrowed,returned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tool_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="user_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="request_date" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="borrow_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="return_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Add any notes about this loan request..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Loan Search View -->
    <record id="tool_loan_view_search" model="ir.ui.view">
        <field name="name">tool.loan.search</field>
        <field name="model">tool.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="tool_id"/>
                <field name="user_id"/>
                <separator/>
                <filter string="My Loans" name="my_loans" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Borrowed" name="borrowed" domain="[('state', '=', 'borrowed')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Tool" name="group_tool" context="{'group_by': 'tool_id'}"/>
                    <filter string="Borrower" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Loan Action (All Loans - for managers) -->
    <record id="tool_loan_action" model="ir.actions.act_window">
        <field name="name">Borrow Requests</field>
        <field name="res_model">tool.loan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="tool_loan_view_search"/>
        <field name="groups_id" eval="[(4, ref('tool_borrow.group_tool_manager'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No loan requests yet
            </p>
            <p>
                Loan requests will appear here when users submit them.
            </p>
        </field>
    </record>

</odoo>
