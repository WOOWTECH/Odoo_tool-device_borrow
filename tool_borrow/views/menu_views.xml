<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu (groups set via record tags below) -->
    <menuitem
        id="menu_tool_borrow_root"
        name="Tool Borrow"
        sequence="50"
        web_icon="tool_borrow,static/description/icon.png"/>

    <!-- Tools Menu -->
    <menuitem
        id="menu_tool_tools"
        name="Tools"
        parent="menu_tool_borrow_root"
        action="tool_tool_action"
        sequence="10"/>

    <!-- Borrow Requests Menu (for managers to see all) -->
    <menuitem
        id="menu_tool_loans"
        name="Borrow Requests"
        parent="menu_tool_borrow_root"
        action="tool_loan_action"
        sequence="20"/>

    <!-- Configuration Menu -->
    <menuitem
        id="menu_tool_config"
        name="Configuration"
        parent="menu_tool_borrow_root"
        sequence="100"/>

    <!-- Tool Categories Menu -->
    <menuitem
        id="menu_tool_categories"
        name="Tool Categories"
        parent="menu_tool_config"
        action="tool_category_action"
        sequence="20"/>

    <!-- Menu groups are set to manager-only via post-migration script and post_init_hook.
         Odoo's res.groups._apply_group() propagates implied groups to menus during XML loading,
         so groups must be corrected AFTER all data files are processed. -->
</odoo>
