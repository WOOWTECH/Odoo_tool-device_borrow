<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_tool_borrow" model="ir.module.category">
        <field name="name">Tool Borrow</field>
        <field name="description">Manage tool borrowing permissions</field>
        <field name="sequence">50</field>
    </record>

    <!-- Security Group: Equipment Manager (single elevated role, like maintenance module) -->
    <record id="group_tool_manager" model="res.groups">
        <field name="name">Equipment Manager</field>
        <field name="category_id" ref="module_category_tool_borrow"/>
        <field name="comment">Full access to manage tools, approve/reject loans, and configure settings</field>
    </record>

    <!-- ============================================================
         Record Rules — tool.tool
         ============================================================ -->
    <!-- Internal users: read-only all tools -->
    <record id="tool_tool_rule_internal" model="ir.rule">
        <field name="name">Tool: Internal users read all</field>
        <field name="model_id" ref="model_tool_tool"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Equipment Manager: full access all tools -->
    <record id="tool_tool_rule_manager" model="ir.rule">
        <field name="name">Tool: Equipment Manager full access</field>
        <field name="model_id" ref="model_tool_tool"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tool_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Portal: read-only all tools -->
    <record id="tool_tool_rule_portal" model="ir.rule">
        <field name="name">Tool: Portal can read all tools</field>
        <field name="model_id" ref="model_tool_tool"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============================================================
         Record Rules — tool.loan
         ============================================================ -->
    <!-- Internal users: own loans only -->
    <record id="tool_loan_rule_internal" model="ir.rule">
        <field name="name">Loan: Internal users own loans</field>
        <field name="model_id" ref="model_tool_loan"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Equipment Manager: full access all loans -->
    <record id="tool_loan_rule_manager" model="ir.rule">
        <field name="name">Loan: Equipment Manager full access</field>
        <field name="model_id" ref="model_tool_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_tool_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Portal: own loans only -->
    <record id="tool_loan_rule_portal" model="ir.rule">
        <field name="name">Loan: Portal own loans</field>
        <field name="model_id" ref="model_tool_loan"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

