<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Tool Stages (Service Status - NOT borrowing status) -->
        <record id="tool_stage_in_service" model="tool.stage">
            <field name="name">In Service</field>
            <field name="sequence">10</field>
            <field name="is_closed">False</field>
            <field name="fold">False</field>
            <field name="description">Tool is in normal service condition</field>
        </record>

        <record id="tool_stage_maintenance" model="tool.stage">
            <field name="name">Under Maintenance</field>
            <field name="sequence">20</field>
            <field name="is_closed">False</field>
            <field name="fold">False</field>
            <field name="description">Tool is under maintenance</field>
        </record>

        <record id="tool_stage_retired" model="tool.stage">
            <field name="name">Retired</field>
            <field name="sequence">30</field>
            <field name="is_closed">True</field>
            <field name="fold">True</field>
            <field name="description">Tool has been retired and is no longer in use</field>
        </record>

        <!-- Default Tool Category -->
        <record id="tool_category_general" model="tool.category">
            <field name="name">General Tools</field>
            <field name="description">General purpose tools without specific category</field>
        </record>
    </data>
</odoo>
